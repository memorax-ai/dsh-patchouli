{
  "name": "dsh-patchouli-native-context-service",
  "version": "0.1.4",
  "description": "Native local context indexing and retrieval for Patchouli",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm run build && node --test 'test/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.8 <0.1.2-0",
    "@deepseek-ai/dsh-fs": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.8 <0.1.2-0",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.8 <0.1.2-0",
    "@deepseek-ai/dsh-session-persistence": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-session-query": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.0-rc.8 <0.1.2-0",
    "@deepseek-ai/dsh-typert-registry": ">=0.1.0-rc.8 <0.1.2-0",
    "@deepseek-ai/dsh-workspace": ">=0.1.0-rc.5 <0.2.0",
    "dsh-patchouli": "0.1.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-session-query": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-persistence": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "dsh-patchouli-protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "dsh-patchouli": "workspace:*"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/memorax-ai/dsh-patchouli.git",
    "directory": "packages/native-context-service"
  },
  "publishConfig": {
    "access": "public"
  }
}
