{
  "name": "dsh-patchouli-artifact-ingestor",
  "version": "0.1.3",
  "description": "DSH attachment and workspace-file ingestion for Patchouli",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-attachment": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-fs": ">=0.1.0-rc.5 <0.2.0",
    "dsh-patchouli": "0.1.3"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "dsh-patchouli-protocol": "workspace:*"
  },
  "devDependencies": {
    "dsh-patchouli": "workspace:*"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/memorax-ai/dsh-patchouli.git",
    "directory": "packages/artifact-ingestor"
  },
  "publishConfig": {
    "access": "public"
  }
}
