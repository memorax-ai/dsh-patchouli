{
  "name": "dsh-patchouli-memory-ui",
  "version": "0.1.0",
  "description": "Knowledge workspace UI for Patchouli and DeepSeek Harness",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm run build:client && pnpm run build:host",
    "build:host": "tsc -p tsconfig.json",
    "build:client": "tsdown --config-loader unrun && tsc -p tsconfig.client.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "pnpm run build && node --test test/*.test.mjs",
    "check": "pnpm run typecheck && pnpm run test",
    "prepare": "pnpm run build"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.19.0",
  "dsh": {
    "plugin": {
      "schemaVersion": 1,
      "displayName": {
        "zh-CN": "Patchouli 记忆界面",
        "en": "Patchouli Memory UI"
      },
      "summary": {
        "zh-CN": "在 DeepSeek Harness 中浏览、检索和理解 Patchouli 知识库。",
        "en": "Browse, retrieve, and understand Patchouli knowledge in DeepSeek Harness."
      },
      "category": "knowledge"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.6",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.6",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "0.22.14",
    "typescript": "^6.0.3",
    "unrun": "0.3.1"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "dsh",
    "dsh-plugin",
    "plugin",
    "knowledge",
    "memory",
    "ui"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/memorax-ai/dsh-patchouli.git",
    "directory": "packages/memory-ui"
  },
  "homepage": "https://github.com/memorax-ai/dsh-patchouli/tree/main/packages/memory-ui#readme",
  "bugs": {
    "url": "https://github.com/memorax-ai/dsh-patchouli/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
