{
  "name": "dsh-patchouli",
  "version": "0.1.5",
  "description": "Native knowledge context for DeepSeek Harness",
  "homepage": "https://github.com/memorax-ai/dsh-patchouli#readme",
  "bugs": {
    "url": "https://github.com/memorax-ai/dsh-patchouli/issues"
  },
  "author": {
    "name": "CH4ACKO3",
    "url": "https://github.com/CH4ACKO3"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./storage": {
      "types": "./lib/storage.d.ts",
      "import": "./lib/storage.js"
    },
    "./cursor-store": {
      "types": "./lib/cursor-store.d.ts",
      "import": "./lib/cursor-store.js"
    },
    "./native-context-at": {
      "types": "./lib/native-context-at.d.ts",
      "import": "./lib/native-context-at.js"
    },
    "./goojfc": {
      "types": "./lib/goojfc/index.d.ts",
      "import": "./lib/goojfc/index.js"
    },
    "./goojfc/graph-memory": {
      "types": "./lib/goojfc/graph-memory.d.ts",
      "import": "./lib/goojfc/graph-memory.js"
    }
  },
  "files": [
    "lib",
    "patches",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p packages/protocol/tsconfig.json && pnpm --filter patchouli-db build && tsc -p tsconfig.json && pnpm run build:client && pnpm --filter dsh-patchouli-agent-loop build && pnpm --filter dsh-patchouli-artifact-ingestor build && pnpm --filter dsh-patchouli-crud-test-plugin build && pnpm --filter dsh-patchouli-session-indexer build && pnpm --filter dsh-patchouli-workspace-indexer build && pnpm --filter dsh-patchouli-native-context-service build",
    "build:client": "tsdown",
    "typecheck": "tsc -p packages/protocol/tsconfig.json && pnpm --filter patchouli-db typecheck && tsc -p tsconfig.json && tsc -p tsconfig.client.json && tsc -p tsconfig.tooling.json && pnpm --filter dsh-patchouli-agent-loop typecheck && pnpm --filter dsh-patchouli-artifact-ingestor typecheck && pnpm --filter dsh-patchouli-crud-test-plugin typecheck && pnpm --filter dsh-patchouli-session-indexer typecheck && pnpm --filter dsh-patchouli-workspace-indexer typecheck && pnpm --filter dsh-patchouli-native-context-service typecheck",
    "test": "pnpm run build && node --test 'test/*.test.ts' 'packages/protocol/test/*.test.ts' 'packages/db/test/*.test.ts' 'packages/native-context-service/test/*.test.ts'",
    "test:e2e": "pnpm run build && cargo build --locked -p patchouli-server --bin patchouli-db && node --test integration/crud-plugin.ts",
    "check": "pnpm run typecheck && pnpm run test",
    "prepare": "pnpm run build"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.19.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "harmony": {
      "patches": [
        "./patches/settings-nav-icon.patch.cjs",
        "./patches/native-context-at.patch.cjs"
      ]
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "immediately": true,
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-storage-domain": ">=0.1.0-rc.5 <0.2.0",
    "dsh-harmony": "^0.8.8",
    "react": "^18.2.0"
  },
  "dependencies": {
    "@deepseek-ai/dsh-typert-protocol": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "patchouli-db": "workspace:*",
    "dsh-patchouli-agent-loop": "workspace:*",
    "dsh-patchouli-artifact-ingestor": "workspace:*",
    "dsh-patchouli-session-indexer": "workspace:*",
    "dsh-patchouli-workspace-indexer": "workspace:*",
    "dsh-patchouli-protocol": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-attachment": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-brand": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-code-runtime": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-fs": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-scope": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session-persistence": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session-projection": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session-query": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session-title": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-storage": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-timeout": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-typert-registry": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-user-approval": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-workspace": "^0.1.1-rc.2",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "dsh-harmony": "^0.8.8",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "deepseek-harness",
    "deepseek-harness-plugin",
    "dsh",
    "dsh-plugin",
    "cordis",
    "memory",
    "knowledge",
    "knowledge-management",
    "local-first",
    "plugin",
    "context"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/memorax-ai/dsh-patchouli.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
